// here we are understanding setup() loop() and pinMode() digitalWrite() 
// this led on off code this is very basic code
// don't forget to put ; at the and of the line 
void setup()
{
    pinMode(8, OUTPUT);
    
 }
void loop()
{
   digitalWrite(8,HIGH);
   delay(2000);
   digitalWrite;(8, LOW)
   delay(2000); 
}
